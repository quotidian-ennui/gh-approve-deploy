#!/usr/bin/env bash
set -eo pipefail

GH_REST_API_VERSION="X-GitHub-Api-Version: 2022-11-28"
GH_ACCEPT="Accept: application/vnd.github+json"
LIST_TEMPLATE='{{tablerow "Status" "Workflow" "Branch"  "URL" "Started" -}}
{{ range . -}}
{{tablerow (.status | autocolor "green") (.workflowName | autocolor "yellow") (.headBranch) (.url | autocolor "cyan")  (timeago .startedAt) -}}
{{end -}}'

usage() {
  cat <<EOF

Usage: gh approve-deploy -w "workflow-name"
       gh approve-deploy https://github.com/OWNER/REPO/actions/runs/RUN_ID

  Required arguments (unless a run URL is given)
  -w  The workflow name

  Optional arguments:
  -b The branch name (default is the default branch)
  -c Comment for the approval (default is 'deploy it')
  -l list workflow runs in a 'waiting' state on the branch

  A workflow run URL can be given as a positional argument instead of -w.
  The repository and run id are extracted from the URL, so it works
  outside of a git checkout.

EXAMPLES
gh approve-deploy -w "deploy-to-prod"
gh approve-deploy https://github.com/quotidian-ennui/local-cluster-terraform/actions/runs/35607976874

EOF
  exit 1
}

function approval_payload() {
  printf "{\"environment_ids\": [%s], \"state\":\"approved\", \"comment\": \"$2\"}" "$1"
}

function gh_api() {
  gh api -H "$GH_REST_API_VERSION" -H "$GH_ACCEPT" "$@"
}

workflow_name=''
branch_name=''
comment=":shipit: deploy it"
list=''
gh_repo=''
run_id=''
url_mode=''

while getopts 'e:w:b:c:lh' flag; do
  case "${flag}" in
  w) workflow_name="${OPTARG}" ;;
  b) branch_name="${OPTARG}" ;;
  c) comment="${OPTARG}" ;;
  l) list="true" ;;
  h) usage ;;
  *) usage ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -gt 0 ]]; then
  if [[ "$1" =~ ^https://github\.com/([^/]+)/([^/]+)/actions/runs/([0-9]+) ]]; then
    gh_repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    run_id="${BASH_REMATCH[3]}"
    url_mode='true'
  else
    echo "Invalid argument [$1]"
    usage
  fi
fi

if [[ -z "$gh_repo" ]]; then
  gh_repo=$(gh repo view --json "nameWithOwner" -q ".nameWithOwner") || true
fi

if [[ "$gh_repo" == "" ]]; then
  echo "I don't appear to be in a repo that's attached to github..."
  usage
fi

if [[ -n "${list}" ]]; then
  gh run list --repo "$gh_repo" -s "waiting" --json "status,displayTitle,workflowName,headBranch,startedAt,url" -t "$LIST_TEMPLATE"
else
  if [[ "$url_mode" == 'true' ]]; then
    if [[ -n "${workflow_name}" ]]; then
      echo "Ignoring -w parameter, run id extracted from the URL"
    fi
  else
    if [[ -z "${workflow_name}" ]]; then
      echo "No Workflow specified"
      usage
    fi
    if [[ -z "$branch_name" ]]; then
      branch_name=$(gh_api repos/"$gh_repo" --jq '.default_branch')
    fi
    run_id=$(gh run list --repo "$gh_repo" -b "$branch_name" --json "databaseId" -w "$workflow_name" -s "waiting" -q ".[].databaseId")
  fi
  target_env=$(gh_api repos/"$gh_repo"/actions/runs/"$run_id"/pending_deployments | jq ".[].environment.id")
  approval_payload "$target_env" "$comment" | gh_api --silent --method POST repos/"$gh_repo"/actions/runs/"$run_id"/pending_deployments --input -
fi
